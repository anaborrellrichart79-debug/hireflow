# Copia este archivo como .env (en esta misma carpeta) y rellena tus valores.
# El .env real no se sube al repositorio (está en .gitignore).

# --- Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=hireflow_user
DB_PASSWORD=
DB_NAME=hireflow

# --- Autenticación
# Clave para firmar los tokens de sesión (JWT). Usa una cadena larga y
# aleatoria, por ejemplo la que genera:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Servidor (opcional; por defecto 3000)
# PORT=3000
