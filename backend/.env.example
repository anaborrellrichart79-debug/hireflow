# Copia este archivo como .env (en esta misma carpeta) y rellena tus valores.
# El .env real no se sube al repositorio (está en .gitignore).

# --- Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=hireflow_user
DB_PASSWORD=
DB_NAME=hireflow

# --- Autenticación
# Clave para firmar los tokens de sesión (JWT). Usa una cadena larga y
# aleatoria, por ejemplo la que genera:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Servidor (opcional; por defecto 3000)
# PORT=3000

# --- Detrás de un proxy (servidor de despliegue)
# Número de proxies delante de la app, normalmente 1. Sirve para que el límite
# de intentos de login vea la IP real de cada usuario. NO lo actives en local:
# sin proxy, cualquiera podría falsear su IP y saltarse el límite.
# TRUST_PROXY=1
